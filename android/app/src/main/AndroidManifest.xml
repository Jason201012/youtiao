<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ 必须声明，否则 requestNotificationsPermission() 静默失败、系统拦截所有通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 应用内更新检测：访问 Gitee 发行版 API 判断是否有新版本 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 应用内下载并安装 APK：Android 8+ 安装未知来源应用必须声明，否则系统安装器直接拒绝 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- 精确闹钟权限：ColorOS 等国产 ROM 对 setAlarmClock 也限制，必须用精确模式才能准点提醒 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- 开机重排闹钟：守护服务进程重启后，把之前的定时提醒重新挂上 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- 前台守护服务所需权限（targetSdk 34+ 必须声明对应前台服务类型权限） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 前台守护服务类型：specialUse（提醒保活），targetSdk 34+ 必须声明对应类型权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 专注结束自动写入系统日历所需权限（add_2_calendar 在运行时请求）。
         顺手发现 #2（v3.1.1 功能增强报告）：READ_CALENDAR 自声明以来从未被
         任何代码使用（全仓检索 CalendarContract / READ_CALENDAR 零命中，
         日历能力只有 add_2_calendar 的「写入」），移除以收窄隐私权限面；
         WRITE_CALENDAR 保留（专注事件写入需要）。后续若做 C3 系统日历只读
         叠加，再按「运行时申请、默认关闭」重新声明。 -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- 附件（P0-1）：拍照所需相机权限 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 附件（P0-1）：录音所需麦克风权限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 附件（P0-1）：Android 13+ 读取相册图片所需权限。
         C-1 修复：image_picker 已显式 requestFullMetadata=false 走系统 Photo Picker，
         不再走传统 content resolver，故不再需要本权限——移除以收窄隐私合规审计面。
         注意：移除后需在真机（尤其 ColorOS / 小米等国产 ROM）验证相册选图仍可走 Photo Picker；
         若个别 ROM 仍走传统选择器，需回退本声明。 -->
    <!-- <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" /> -->
    <!-- 附件（P0-1）：Android 12 及以下读取外部存储（相册 / 文件）所需权限。
         P2-10 收窄：仅保留到 API 29；API 30+ 选文件走 SAF / Photo Picker，不再申请 broad 存储读权限。
         已移除 READ_MEDIA_VIDEO（应用不读取视频库，选文件统一走 SAF）。 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- A4 应用锁（local_auth）：使用生物识别（指纹/面容）解锁所需权限 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <application
        android:label="有条"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 接收「分享」：文本（微信/QQ 转发一段文字）、图片、任意文件统一在此入口接收。
                 P2-C：早期并列声明了 text/plain、image/*、*/* 三个过滤器，而 */* 本身就能匹配
                 前两者，导致系统分享面板里「有条」重复出现、且同一 intent 被重复分发。
                 现合并为单一 */* 过滤器，原生侧按「有无 EXTRA_STREAM」分流：
                 有 → dispatchShareStream（附件建任务），无 → dispatchShareText（文本建任务）。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- 前台守护服务：独立进程 + 用户划掉任务也不停，保证划掉后台后定时提醒仍准时 -->
        <service
            android:name=".ReminderForegroundService"
            android:exported="false"
            android:process=":guard"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="reminder_guard" />
        </service>

        <!-- 定时通知广播接收器：必须显式声明，否则 App 被杀后 AlarmManager 找不到接收器。
             放到 :guard 进程后，主进程被 ColorOS 划掉时，广播直接在已存活的守护进程里处理，
             无需重启主进程，从而绕过 ColorOS 对「被杀后重启主进程」的拦截。 -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"
            android:process=":guard" />

        <!-- 开机后重新调度所有定时通知 -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 每日任务「当天 00:00 自动重置」接收器：放到 :guard 进程，
             与 ScheduledNotificationReceiver 一致——主进程被 ColorOS 划掉时，
             仍然由已存活的守护进程在午夜闹钟触发时完成重置，无需用户打开 App。 -->
        <receiver
            android:name=".MidnightResetReceiver"
            android:exported="false"
            android:process=":guard">
            <intent-filter>
                <action android:name="com.example.todolist.MIDNIGHT_RESET" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 桌面小组件（今日任务列表）：4×2，独立 AppWidgetProvider，跨进程只读 youtiao.db。
             APPWIDGET_UPDATE 为受保护广播，仅系统可发；receiver 显式声明 exported=false。 -->
        <receiver
            android:name=".TodayWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- 应用内更新：把下载到外部缓存的 APK 经 FileProvider 暴露给系统安装器
             （Android 7+ 禁止以 file:// 跨应用传递，必须用 content:// + 授权）。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
