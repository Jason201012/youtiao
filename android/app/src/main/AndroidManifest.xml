<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ 必须声明，否则 requestNotificationsPermission() 静默失败、系统拦截所有通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 应用内更新检测：访问 Gitee 发行版 API 判断是否有新版本 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 应用内下载并安装 APK：Android 8+ 安装未知来源应用必须声明，否则系统安装器直接拒绝 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- 精确闹钟权限：ColorOS 等国产 ROM 对 setAlarmClock 也限制，必须用精确模式才能准点提醒 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- 开机重排闹钟：守护服务进程重启后，把之前的定时提醒重新挂上 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- 前台守护服务所需权限（targetSdk 34+ 必须声明对应前台服务类型权限） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 前台守护服务类型：specialUse（提醒保活），targetSdk 34+ 必须声明对应类型权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <application
        android:label="有条"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- 前台守护服务：独立进程 + 用户划掉任务也不停，保证划掉后台后定时提醒仍准时 -->
        <service
            android:name=".ReminderForegroundService"
            android:exported="false"
            android:process=":guard"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="reminder_guard" />
        </service>

        <!-- 定时通知广播接收器：必须显式声明，否则 App 被杀后 AlarmManager 找不到接收器。
             放到 :guard 进程后，主进程被 ColorOS 划掉时，广播直接在已存活的守护进程里处理，
             无需重启主进程，从而绕过 ColorOS 对「被杀后重启主进程」的拦截。 -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"
            android:process=":guard" />

        <!-- 开机后重新调度所有定时通知 -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 每日任务「当天 00:00 自动重置」接收器：放到 :guard 进程，
             与 ScheduledNotificationReceiver 一致——主进程被 ColorOS 划掉时，
             仍然由已存活的守护进程在午夜闹钟触发时完成重置，无需用户打开 App。 -->
        <receiver
            android:name=".MidnightResetReceiver"
            android:exported="false"
            android:process=":guard">
            <intent-filter>
                <action android:name="com.example.todolist.MIDNIGHT_RESET" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 应用内更新：把下载到外部缓存的 APK 经 FileProvider 暴露给系统安装器
             （Android 7+ 禁止以 file:// 跨应用传递，必须用 content:// + 授权）。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
